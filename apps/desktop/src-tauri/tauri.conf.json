{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradeSight",
  "version": "0.1.0",
  "identifier": "com.tradesight.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TradeSight",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#0B0E14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "publisher": "TradeSight",
    "category": "Finance",
    "shortDescription": "Trading assistant forex & saham IDX",
    "longDescription": "Chart realtime, deteksi support/resistance otomatis, indikator RSI/MACD/MA dan saran entry/TP/SL berbasis risk-reward.",
    "externalBin": ["binaries/tradesight-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Indonesian"],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
